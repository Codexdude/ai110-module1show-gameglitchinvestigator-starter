class Course:
    """Represents a course with a name and list of students."""
    def __init__(self, name):
        self.name = name
        self.students = []

    def add_student(self, student):
        self.students.append(student)

    def __repr__(self):
        return f"Course({self.name!r}, students={len(self.students)})"
    
class Student:
    """Represents a student with a name and optional id."""
    def __init__(self, name, student_id=None):
        self.name = name
        self.id = student_id

    def __repr__(self):
        return f"Student({self.name!r}, id={self.id!r})"